[Unit]
Description=rfrp server (Rust Fast Reverse Proxy)
After=network.target

[Service]
Type=simple
User=rfrp
Group=rfrp
WorkingDirectory=/etc/rfrp
ExecStart=/usr/local/bin/rfrp server -c /etc/rfrp/rfrp-server.toml
Restart=on-failure
RestartSec=5
# 反向代理每条连接占一个 fd；systemd 默认上限常见为 1024。
LimitNOFILE=65536
# 自动创建并通过 ReadWritePaths 暴露持久化/日志目录。
StateDirectory=rfrp
LogsDirectory=rfrp
NoNewPrivileges=true
# 需要绑定 80/443 等 <1024 端口时取消注释；NoNewPrivileges 下 setcap 不会生效。
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# 配置热重启建议使用 --watch-config=exit；restart 模式需要在配置同目录
# （默认 /etc/rfrp）写 stage 快照，与本单元的 ProtectSystem=strict 冲突。
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rfrp /var/log/rfrp

[Install]
WantedBy=multi-user.target
