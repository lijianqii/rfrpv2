# rfrp 文件日志轮转（可选）
#
# 仅当 [log].output = "file:/var/log/rfrp/..." 时需要；
# 使用 journald/stderr 的部署由 journald 管理，不需要此文件。
#
# copytruncate 不需要进程重新打开文件，但轮转瞬间可能丢失极少量日志行；
# 如果要求严格不丢行，可改为文件轮转 + 进程内 reopen（当前未实现）。
/var/log/rfrp/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su rfrp rfrp
}
