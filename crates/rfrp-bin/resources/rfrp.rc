// rfrp Windows 资源：版本信息 + 应用清单 + 图标。
// 不 include <winresrc.h>，避免交叉编译时依赖 Windows SDK 头文件（ID 直接用数字）。

1 VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "rfrp contributors"
            VALUE "FileDescription",  "rfrp - Rust Fast Reverse Proxy"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "rfrp"
            VALUE "LegalCopyright",   "Copyright (c) 2026 rfrp contributors. Licensed under the MIT License."
            VALUE "OriginalFilename", "rfrp.exe"
            VALUE "ProductName",      "rfrp"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// 应用清单（RT_MANIFEST，ID 1）：asInvoker 不请求管理员权限，声明 Win10/11
// 兼容与 DPI 感知，避免 UAC 弹窗与缩放模糊带来的"非正规程序"观感。
1 RT_MANIFEST "rfrp.manifest.xml"

// 程序图标（ID 1 作为默认图标）。
1 ICON "rfrp.ico"